(library
 (name theora)
 (public_name theora)
 (synopsis "OCaml bindings for libtheora")
 (enabled_if (= %{read:../detect/theora_available} true))
 (libraries ogg)
 (modules theora)
 (foreign_stubs
  (language c)
  (names theora_stubs)
  (flags
   (:include ../detect/theora_c_flags.sexp)))
 (c_library_flags
  (:include ../detect/theora_c_library_flags.sexp)))

